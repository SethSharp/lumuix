{
  "name": "@sethsharp/lumuix",
  "version": "1.0.0-beta.8",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SethSharp/lumuix"
  },
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "run-p format type-check lint",
    "format": "prettier --write src/ documentation/",
    "type-check": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "lint": "eslint . --fix"
  },
  "main": "./dist/ui.umd.cjs",
  "module": "./dist/ui.js",
  "exports": {
    ".": {
      "import": "./dist/lumuix.js",
      "require": "./dist/lumuix.umd.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./dist/types/presets/*.css": {
      "import": "./dist/types/presets/*.css",
      "require": "./dist/types/presets/*.css"
    }
  },
  "dependencies": {
    "@vueuse/core": "^13.2.0",
    "class-variance-authority": "^0.7.0",
    "lucide-vue-next": "^0.447.0",
    "radix-vue": "^1.9.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "vue": "^3.5.13",
    "vue-component-type-helpers": "^2.0.29"
  },
  "devDependencies": {
    "@babel/types": "^7.24.7",
    "@inertiajs/vue3": "^1.0.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.8.0",
    "vite-plugin-static-copy": "^1.0.6",
    "vue-tsc": "^2.2.8"
  }
}
